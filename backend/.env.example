# NVIDIA API (https://build.nvidia.com) - server-side only, never expose to the frontend
NVIDIA_API_KEY=
NEMOTRON_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional tuning
NEMOTRON_TIMEOUT_SECONDS=90
NEMOTRON_MAX_TOKENS=6000
STATIC_TOOL_TIMEOUT_SECONDS=20
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=INFO
