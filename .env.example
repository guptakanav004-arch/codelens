# ---- Frontend / Next.js server (copy to .env.local) ----
# Optional: base URL of the browser -> API calls. Leave empty to use same-origin /api routes.
NEXT_PUBLIC_API_BASE_URL=

# Optional: when set, /api/* routes proxy to the Python FastAPI backend (backend/).
# When empty, the built-in TypeScript engine handles requests.
BACKEND_API_URL=

# ---- NVIDIA Nemotron (used by the built-in engine; the Python backend has its own backend/.env) ----
NVIDIA_API_KEY=
NEMOTRON_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
